# Rust build artifacts
/target

# Storyteller index: disposable cache, rebuilt from the markdown files.
# Matches any project folder, including the test fixtures.
**/.storyteller/cache.sqlite
**/.storyteller/cache.sqlite-shm
**/.storyteller/cache.sqlite-wal
# The server writes this itself to keep the cache out of git; it is generated,
# not part of the fixture.
**/.storyteller/.gitignore
